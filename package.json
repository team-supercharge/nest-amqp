{
  "name": "@team-supercharge/nest-amqp",
  "version": "3.6.4",
  "description": "AMQP 1.0 module for Nest framework",
  "author": "Supercharge",
  "license": "MIT",
  "keywords": [
    "amqp",
    "queue",
    "nest"
  ],
  "engines": {
    "node": ">16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/team-supercharge/nest-amqp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "npx rimraf dist",
    "prebuild:prod": "npx rimraf dist",
    "build": "npx nest build",
    "build:prod": "npx nest build -p tsconfig.prod.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "release": "commit-and-tag-version",
    "codecov": "codecov",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:clear": "jest --clearCache true --clearMocks true && jest",
    "check": "npm run lint && npm run build && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "rhea-promise": "^3.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.1",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "codecov": "3.8.3",
    "commit-and-tag-version": "12.6.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "json": "11.0.0",
    "prettier": "3.6.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.0",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "type-fest": "4.41.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.15",
    "@nestjs/core": ">=10.0.15",
    "class-transformer": ">=0.5.1",
    "class-validator": ">=0.14.2"
  }
}
